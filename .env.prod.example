# ---- Required --------------------------------------------------------------------------------------------
ADMIN_DB_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
# Generate each with: openssl rand -hex 32
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=
# The public address people use, with no slash at the end
APP_URL=https://recruit.example.com

# ---- Single-agency install --------------------------------------------------------------------------------
# Leave TENANT_MODE empty for the shared multi-agency service. For one agency on its own server, set both below.
TENANT_MODE=
# The seller's public key, given with your purchase
LICENSE_PUBLIC_KEY=

# ---- Messages (leave empty to log messages instead of sending them) ----------------------------------------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=
SMTP_URL=
EMAIL_FROM=

# ---- Shared service only: how agencies pay you ------------------------------------------------------------
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_ENV=production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_DETAILS=
# e.g. yourapp.co.ke, so acme.yourapp.co.ke opens that agency's candidate pages
APP_DOMAIN=
SIGNUP_ENABLED=true
TRIAL_DAYS=14

# ---- Optional storage and scanning -----------------------------------------------------------------------
STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
CLAMAV_HOST=
CLAMAV_REQUIRED=
