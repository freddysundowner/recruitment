# Runtime connection: non-owner role, row-level security applies
DATABASE_URL=postgres://recruit_app:recruit_app_dev@localhost:5434/recruit
# Migrations and seed only: table owner
MIGRATE_DATABASE_URL=postgres://recruit_admin:recruit_admin_dev@localhost:5434/recruit
# At least 32 characters
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Where uploaded documents are stored (swap for S3/MinIO later)
STORAGE_DIR=./storage

# Public address of this app (used for M-Pesa callbacks and links in messages)
APP_URL=http://localhost:3100
# 64 hex characters; encrypts ID numbers and saved secrets. Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
# Set to mock to try M-Pesa without Safaricom (results are simulated on screen)
MPESA_MODE=
# SMS (Africa's Talking), WhatsApp Business Cloud API and email (SMTP). Unset = messages are logged, not delivered
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=
SMTP_URL=
EMAIL_FROM=
# File storage: local disk by default; set STORAGE_DRIVER=s3 for S3, R2 or MinIO
STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# Optional virus scanning with ClamAV
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=
